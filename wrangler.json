{
  "name": "rabotnicheska-kultura",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMIT",
      "namespace_id": "834217",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "database",
      "database_id": "251fa1c9-8ed4-4126-995e-d4dee64adcd0",
      "migrations_dir": "migrations"
    }
  ]
}
